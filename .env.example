# RightGuards Cards Environment Variables

# API Configuration
VITE_API_BASE_URL=https://api.rightguards.com
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=RightGuards Cards

# Authentication
VITE_JWT_SECRET=your-jwt-secret-key-here
VITE_JWT_EXPIRES_IN=7d

# Payment Integration
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
VITE_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Analytics & Monitoring
VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
VITE_MIXPANEL_TOKEN=your_mixpanel_token_here
VITE_SENTRY_DSN=your_sentry_dsn_here

# Email Services
VITE_SENDGRID_API_KEY=your_sendgrid_api_key_here
VITE_SUPPORT_EMAIL=support@rightguards.com

# SMS Services (for MFA)
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
VITE_TWILIO_PHONE_NUMBER=+1234567890

# Social Login
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
VITE_APPLE_CLIENT_ID=your_apple_client_id_here

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_MFA=true
VITE_ENABLE_TEAM_FEATURES=true

# Development
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_HTTPS_ONLY=true

# CDN & Assets
VITE_CDN_URL=https://cdn.rightguards.com
VITE_ASSETS_URL=https://assets.rightguards.com
